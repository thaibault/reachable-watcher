{
  "name": "reachable-watcher",
  "version": "2.0.1",
  "description": "Check status codes of web servers and sends notification e-mails",
  "keywords": [
    "reachable",
    "watcher",
    "bash",
    "status",
    "code",
    "checker",
    "online"
  ],
  "homepage": "https://tsickert.com/reachable-watcher",
  "license": "CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/reachable-watcher.git"
  },
  "main": "reachable-watcher.sh",
  "bin": {
    "reachable-watcher": "reachable-watcher.sh"
  },
  "files": [
    "reachable-watcher.service"
  ],
  "scripts": {
    "clear": "rimraf apiDocumentation",
    "document": "mkdir --parents apiDocumentation/reachable-watcher/latest && bash ./node_modules/.bin/bashlink-document reachable-watcher 1>apiDocumentation/reachable-watcher/latest/index.html",
    "document:show": "bash ./node_modules/.bin/bashlink-document reachable-watcher",
    "document:show:error": "bash ./node_modules/.bin/bashlink-document reachable-watcher 1>/dev/null",
    "lint": "shellcheck -x *.sh",
    "lint:given": "shellcheck -x",
    "test": "bash ./node_modules/.bin/bashlink-doctest --verbose ../../reachable-watcher",
    "update:documentation": "web-documentation"
  },
  "dependencies": {
    "bashlink": "^2.0.1"
  },
  "devDependencies": {
    "rimraf": "^6.1.4",
    "shellcheck": "^4.1.0",
    "web-documentation": "^1.0.77"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ]
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
