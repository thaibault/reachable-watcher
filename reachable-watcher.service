[Unit]
Description=Checks server reachabilities.
Conflicts=shutdown.target reboot.target halt.target
Wants=network-online.target
After=network.target network-online.target

[Service]
Restart=always
RestartSec=10
# NOTE: A relative name is searched in "/usr/local/bin" and "/usr/bin" so that
# global npm installations are found as well.
ExecStart=reachable-watcher
NotifyAccess=all

[Install]
WantedBy=multi-user.target
